<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: ни облачной копии, ни переноса на новый телефон — там ключ API -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
