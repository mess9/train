# Образец секрета Jenkins train-env (Secret file). Значения сюда не вписывать:
# заполненный файл живёт только в Jenkins (или рядом, как train.env, — он в .gitignore),
# в репозиторий не попадает.

# Пароль Postgres: openssl rand -hex 24.
# Записывается в базу при первом старте — потом менять только вместе с ALTER USER.
TRAIN_POSTGRES_PASSWORD=

# Первый пользователь: почта (та же, что пустит Cloudflare Access) и его API-ключ —
# openssl rand -hex 24. Создаются при старте, повторный старт ничего не дублирует.
TRAIN_BOOTSTRAP_EMAIL=
TRAIN_BOOTSTRAP_KEY=

# Необязательно. Папка датасета на хосте (data/exercises.json, images/, videos/),
# по умолчанию /mnt/safe_storage/data/train/exercises-dataset
# TRAIN_DATASET_DIR=
# Папка фото на хосте, по умолчанию /mnt/safe_storage/data/train/photos; владелец — 1000:1000
# TRAIN_PHOTOS_DIR=
# Порт на хосте, по умолчанию 127.0.0.1:7313; TRAIN_BIND=0.0.0.0 — открыть в локальную сеть
# TRAIN_BIND=
# TRAIN_PORT=
